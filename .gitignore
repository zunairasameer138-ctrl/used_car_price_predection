# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/

# --- Virtual environments ---
venv/
.venv/
env/
ENV/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Testing / tooling ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# --- Environment / secrets ---
.env
.env.*

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Project-generated artifacts (regenerate with `python src/train_model.py`) ---
data/processed/*.csv
models/*.pkl
reports/*.json
reports/*.csv
reports/figures/*.png
!data/processed/.gitkeep
!models/.gitkeep
!reports/.gitkeep
!reports/figures/.gitkeep

# --- Raw dataset ---
# Kept OUT of git on purpose: it's third-party data (see README -> Dataset)
# that anyone can re-download with the documented link, and it's not
# Claude's / the author's to redistribute via version control.
data/raw/*.csv
data/raw/*.xlsx
!data/raw/.gitkeep
